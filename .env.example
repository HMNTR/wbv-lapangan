# Salin berkas ini menjadi .env sebelum menjalankan `docker compose up -d --build`
# (Opsional — jika tidak dibuat, nilai bawaan di docker-compose.yml akan dipakai)

# Port publik di server host (akses: http://<IP-SERVER>:8080)
APP_PORT=8080

# Kredensial database (WAJIB diganti untuk server produksi sebelum jalankan pertama kali)
DB_USER=wbv
DB_PASS=ganti_dengan_password_kuat
DB_ROOT_PASS=ganti_dengan_root_password_kuat
